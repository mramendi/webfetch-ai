# playwright-ai: independent Playwright fetch service (NOT the OWUI bundle).
# Official image brings Node + Chromium + all system deps; we add a small
# extraction stack (jsdom + readability + node-html-markdown) and the service.
# Version tag is current-stable at build time; bump = edit this line + rebuild.
FROM mcr.microsoft.com/playwright:v1.64.0-noble
WORKDIR /app
COPY package.json fetch-server.mjs ./
# playwright pkg must match the image version; browsers come from the image's
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright, so skip the postinstall download.
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --omit=dev --no-audit --no-fund
EXPOSE 8080
CMD ["node", "fetch-server.mjs"]
